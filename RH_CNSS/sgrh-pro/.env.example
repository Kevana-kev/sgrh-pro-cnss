APP_NAME="SGRH Pro"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votredomaine.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- MySQL (Railway / Hostinger / production) ---
# Sur Railway : utilisez les variables MYSQL* fournies par le plugin MySQL
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sgrh_pro
DB_USERNAME=sgrh_user
DB_PASSWORD=changez_moi

# Seed automatique au premier démarrage Railway uniquement
SEED_ON_BOOT=false

# --- Local rapide (SQLite) : décommenter et commenter le bloc MySQL ---
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database/sgrh.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@cnss.cd"
MAIL_FROM_NAME="${APP_NAME}"

# Bridge biométrie ZK-9500 (PC local uniquement)
BIOMETRIC_BRIDGE_URL=http://127.0.0.1:5002
BIOMETRIC_BRIDGE_API_KEY=local-secret-key

VITE_APP_NAME="${APP_NAME}"
